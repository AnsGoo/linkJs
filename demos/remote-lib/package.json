{
  "name": "vue-components-starter",
  "type": "module",
  "version": "0.0.0",
  "description": "A starter for creating a Vue component library.",
  "author": "Author Name <author.name@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "exports": {
    ".": "./mf/lib.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./mf/lib.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm --filter unplugin-linkjs --filter tsdown-plugin-server --filter linkjs build && tsdown",
    "dev": "pnpm --filter unplugin-linkjs --filter tsdown-plugin-server --filter linkjs build && tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "linkjs": "workspace:*",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^4.1.11",
    "bumpp": "^10.4.1",
    "playwright": "^1.64.0",
    "tsdown": "^0.21.10",
    "tsdown-plugin-server": "workspace:*",
    "typescript": "^5.9.3",
    "unplugin-linkjs": "workspace:*",
    "unplugin-vue": "^7.2.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.25",
    "vue-tsc": "^3.3.12"
  },
  "inlinedDependencies": {
    "@vue/devtools-kit": [
      "7.7.10",
      "8.2.1"
    ],
    "@vue/devtools-shared": [
      "7.7.10",
      "8.2.1"
    ],
    "@vue/reactivity": "3.5.43",
    "@vue/runtime-core": "3.5.43",
    "@vue/runtime-dom": "3.5.43",
    "@vue/shared": "3.5.43",
    "hookable": "5.5.3",
    "nostics": "1.3.0",
    "perfect-debounce": [
      "1.0.0",
      "2.1.0"
    ],
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  }
}
