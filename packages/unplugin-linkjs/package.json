{
  "name": "unplugin-linkjs",
  "version": "1.0.0",
  "description": "A plugin for automatically generating manifest.json files when building JS packages with tsdown, rollup, etc.",
  "license": "ISC",
  "author": "",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "unplugin": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "magic-string": "0.30.21",
    "oxc-parser": "^0.114.0",
    "rolldown": "^1.0.0-r3",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.3"
  }
}
