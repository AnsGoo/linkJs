{
  "name": "share-runtime",
  "version": "1.0.0",
  "description": "A plugin for automatically generating manifest.json files when building JS packages with tsdown, rollup, etc.",
  "license": "ISC",
  "author": "",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "build:cdn": "node --import tsx src/index.ts",
    "build:all": "node --import tsx src/index.ts --all"
  },
  "dependencies": {
    "linkjs": "workspace:*",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "rolldown": "^1.0.0-r3",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
