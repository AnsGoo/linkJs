{
  "name": "linkjs",
  "version": "0.0.0",
  "description": "LinkJS runtime: module loading, shared-dependency management, and remote exposure for micro-frontends.",
  "homepage": "https://github.com/AnsGoo/linkJs#readme",
  "bugs": {
    "url": "https://github.com/AnsGoo/linkJs/issues"
  },
  "license": "MIT",
  "author": "AnsGoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnsGoo/linkJs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./vue": "./dist/vue.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.43"
  }
}
