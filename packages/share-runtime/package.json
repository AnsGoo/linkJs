{
  "name": "share-runtime",
  "version": "1.0.0",
  "description": "Standalone CLI to bundle dependencies as CDN-ready ESM packages (experimental; NOT part of the linkjs runtime).",
  "license": "ISC",
  "author": "",
  "files": [
    "lib"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "build:cdn": "node --import tsx src/index.ts",
    "build:all": "node --import tsx src/index.ts --all"
  },
  "dependencies": {
    "linkjs": "workspace:*",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "rolldown": "^1.2.13",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
