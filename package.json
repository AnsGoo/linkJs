{
  "name": "linkjs-space",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/AnsGoo/linkJs#readme",
  "bugs": {
    "url": "https://github.com/AnsGoo/linkJs/issues"
  },
  "license": "ISC",
  "author": "AnsGoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnsGoo/linkJs.git"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:ext": "pnpm --filter linkjs-devtools-extension build",
    "dev:ext": "pnpm --filter linkjs-devtools-extension dev",
    "dev:showcase": "pnpm --filter linkjs-showcase dev",
    "prepare": "pnpm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.28.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.21.10",
    "vitepress": "^1.6.4"
  }
}
